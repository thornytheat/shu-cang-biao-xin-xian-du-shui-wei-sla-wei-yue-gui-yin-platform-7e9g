# ---- 项目标识 ----
COMPOSE_PROJECT_NAME=freshsla

# ---- 端口（题目分配，不可改）----
FRONTEND_PORT=18254
BACKEND_PORT=19254
DB_PORT=17754

# ---- 数据库 ----
DB_NAME=freshsla
DB_USER=freshsla
DB_PASSWORD=freshsla_pw_2026
DB_ROOT_PASSWORD=freshsla_root_2026

# ---- 安全 ----
JWT_SECRET=freshsla-jwt-secret-change-me-2026

# ---- 运行时 ----
REDIS_URL=redis://redis:6379/0
SEED_DEMO=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WRITE_PER_MINUTE=120
# 业务时区：所有就绪时刻按 UTC+8 解释
APP_TIMEZONE_OFFSET_MINUTES=480
# 新鲜度分位基线窗口（天）
CALIBRATION_DAYS=30
# npm 镜像（Dockerfile ARG 可覆盖）
NPM_REGISTRY=https://registry.npmmirror.com
